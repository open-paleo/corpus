{
    "compilerOptions": {
        "target": "ES2024",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2024", "DOM", "DOM.Iterable"],
        "allowJs": true,
        "checkJs": true,
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true
    },
    "include": ["src/corpus/web/static/*.js", "src/corpus/web/static/pdfjs/*.d.mts"]
}
