# Secrets — never commit. Use .env.example as a template.
.env

# Hidden runtime infrastructure: venv, caches, BHL dumps, transient logs.
# Regenerable via scripts/bootstrap.sh + scripts/bhl_setup.py.
.runtime/

# FTS5 index — regenerable from markdown/ via scripts/indexer.py.
index/

# Embedded raster images ripped from PDFs — regenerable from pdfs/ via
# scripts/extract_pdf_images.py.
pdf_images/

# BHL page images (JP2) downloaded by scripts/bhl_fetch.py, stitched into
# pdfs/; regenerable from BHL's S3 bucket.
bhl_images/

# User-provided source images for stitching into pdfs/ via
# scripts/stitch_source_images.py. One subdir per citation key.
source_images/

# macOS + atomic-write artifacts.
.DS_Store
*.tmp
manifest.json.tmp

# Python.
__pycache__/
*.pyc

# Claude Code session-local state (permission allowlist, scheduled-task locks).
# Ignore everything under .claude/ except shared skills and plans (version-controlled).
.claude/*
!.claude/skills/
!.claude/skills/**
!.claude/plans/
!.claude/plans/**

# corpus.manifest write lock
manifest.json.lock

# Reports the QC and audit scripts write at the root (regenerable). A
# private archive that tracks one is unaffected, as below.
TRANSLATION_AUDIT.md

# This checkout's own record of what it holds: never part of the public
# repository. (A private archive that tracks it is unaffected: ignore rules
# do not apply to files already tracked.)
manifest.json

# npm dev tools for the web app's browser code (package.json)
node_modules/
